<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <%= render "users/profile_summary", user: @user %>
  </aside>
  <div class="col-md-8">
    <% if @user.tournaments.any? %>
      <h3>作成した大会 (<%= @user.tournaments.count %>)</h3>
      <div class="row">
        <%= render @tournaments %>
      </div>
      <%= will_paginate @tournaments %>
    <% end %>

    <% if @predicted_tournaments.any? %>
      <h3>過去の予想 (<%= @predicted_tournaments.count %>)</h3>
      <ul class="list-group profile-tournament-stats-list">
        <% @predicted_tournaments.each do |tournament| %>
          <li class="list-group-item">
            <%= link_to tournament.title, tournament %>
            <%= render "users/profile_stats", user: @user, tournament: tournament %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
