<div class="profile-summary-score">
  <div class="profile-summary-stat">
    <div class="profile-summary-stat-value"><%= user.score(tournament) %>pt</div>
    <div class="profile-summary-stat-label">スコア</div>
  </div>
  <div class="profile-summary-stat">
    <div class="profile-summary-stat-value">Top <%= user.score_percentile(tournament) %>%</div>
