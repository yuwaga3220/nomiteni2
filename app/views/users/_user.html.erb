<li>
  <%= gravatar_for user, size: 50 %>
  <%= link_to user.name, user, class: "user-name-link" %>
  <% if current_user.admin? && !current_user?(user) %>
    | <%= link_to "削除", user,
      data: {
        "turbo-method": :delete,
        turbo_confirm: "本当によろしいですか？"
      }
    %>
  <% end %>
</li>