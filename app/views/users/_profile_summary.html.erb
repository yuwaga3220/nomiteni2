<% current_tournament = local_assigns[:current_tournament] %>
<div class="profile-summary">
  <div class="profile-summary-header">
    <%= gravatar_for user, size: 70 %>
    <h3><%= link_to user.name, user, class: "profile-summary-name" %></h3>
  </div>
  <% if current_tournament.present? %>
    <%= render "users/profile_stats", user: user, tournament: current_tournament %>
  <% end %>
</div>
