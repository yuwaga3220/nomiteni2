<% provide(:title, "試合結果を予想") %>
<%= link_to "← ホームへ戻る", root_path, class: "home-link" %>
<%= render "help_modal" %>
<h1 style="margin-bottom: 5px;">PICK'EMS</h1>
<h2 style="margin-top: 0px;"> <%= @tournament.title %></h2>
<%= render "users/profile_summary", user: current_user, current_tournament: @tournament %>
<div class="row">
  <% if @tournament.matches.empty? %>
    <div class="alert alert-warning">まだドローが作成されていません。</div>
  <% else %>
    <div class="col-md-9">  
      <% if @tournament.before? %>
        <%# 操作方法が一目でわかるよう、ブラケットの上に吹き出しで案内する（通常の配置なのでボタンとは重ならない） %>
        <div class="prediction-guide">
          <span class="glyphicon glyphicon-hand-down" aria-hidden="true"></span>
          参加者名をタップして勝者を予想しよう
        </div>
      <% else %>
        <div class="alert alert-warning">現在予想を受け付けていません。</div>
      <% end %>
      <% if @biggest_upset_match %>
          <div class="upset-highlight">
            <div class="upset-highlight-label"><h4>BEST OF GIANT KILLER</h4></div>
            <div class="upset-highlight-winner"><h3><%= @biggest_upset_match.winner&.name %></h1></div>
          </div>
        <% end %>
      <% if @best_predictor %>
          <div class="upset-highlight">
            <div class="upset-highlight-label"><h4>BEST PREDICTOR</h4></div>
            <div class="upset-highlight-winner"><h3><%= @best_predictor.name %></h3></div>
          </div>
        <% end %>
      <% if @tournament.before? %>
        <div id="next-prediction-card">
          <%= render "next_prediction_card" %>
        </div>
      <% end %>
      <div id="prediction-bracket">
        <%= render "tournaments/prediction_bracket" %>
      </div>
    </div>
    <div class="col-md-3">
      <% if @tournament.participants.any? %>
        <% unless @tournament.before? %>
          <%= render "prediction_log" %>
        <% end %>
        <%= render "ranking" %>
      <% end %>
    </div>
  <% end %>
</div>
<% if @tournament.before? %>
  <%# 予想の進捗は画面下部に固定表示する（フッターが隠れないよう custom.scss で body に余白を付ける） %>
  <div id="prediction-progress" class="prediction-progress-footer">
    <%= render "progress" %>
  </div>
<% end %>
