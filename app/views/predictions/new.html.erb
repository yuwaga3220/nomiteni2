<% provide(:title, "試合結果を予想") %>
<%= link_to "← ホームへ戻る", root_path %>
<h2>結果を予想する — <%= @tournament.title %></h2>
<%= render "tournaments/tournament_info", tournament: @tournament %>
<div class="row">
  <div class="col-md-9">
    <%= render "tournaments/prediction_bracket" %>
  </div>
  <div class="col-md-3">
    <%= render "ranking" %>
  </div>
</div>
