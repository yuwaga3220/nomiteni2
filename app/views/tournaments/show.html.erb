<% provide(:title, @tournament.title) %>
<%= link_to "← ホームへ戻る", root_path, class: "home-link" %>
<h1 style="margin-bottom: 5px;">TOURNAMENT</h1>
<h2 style="margin-top: 0px;"><%= @tournament.title %></h2>

<% owner_view = current_user?(@tournament.user) %>
<%= turbo_stream_from "tournament_#{@tournament.id}_#{owner_view ? 'owner' : 'public'}" %>

<%= render "status_section", tournament: @tournament, owner_view: owner_view %>
