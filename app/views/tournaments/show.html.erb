<% provide(:title, @tournament.title) %>
<%= link_to "← ホームへ戻る", root_path %>
<h2>試合状況 - <%= @tournament.title %></h2>
<%= render "tournament_info", tournament: @tournament %>

<% unless @tournament.matches.any? %>
  <div class="row">
    <%= render "participant_list" %>
    <%= render "participant_form" if current_user?(@tournament.user) %>
  </div>
<% end %>

<%= render "bracket", 
  editable: current_user?(@tournament.user) && @tournament.during? if @tournament.matches.any? %>