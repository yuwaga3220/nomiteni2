<% provide(:title, @tournament.title) %>
<div class="tournament">
  <h1><%= @tournament.title %></h1>
  <% if @tournament.held_on.present? %>
    <p>開催日: <%= @tournament.held_on.strftime("%Y年%m月%d日") %></p>
  <% end %>
  <% if @tournament.venue.present? %>
    <p>場所: <%= @tournament.venue %></p>
  <% end %>
  <% if @tournament.description.present? %>
    <p><%= @tournament.description %></p>
  <% end %>
</div>

<div class="row">
  <div class="<%= current_user?(@tournament.user) ? 'col-md-8' : 'col-md-12' %>">
    <h3>参加選手（<%= @tournament.players.count %>人）</h3>
    <% players = @tournament.players.order(:position, :created_at) %>
    <% if current_user?(@tournament.user) %>
      <p>１回戦のポジションを入力してください。空欄の場合は自動で決定されます。</p>
      <%= form_with(url: update_positions_tournament_players_path(@tournament), method: :patch) do |f| %>
        <ul class="list-group">
          <% players.each do |player| %>
            <li class="list-group-item">
              <%= number_field_tag "positions[#{player.id}]", player.position,
                    placeholder: "#", min: 1, max: @tournament.players.count,
                    class: "form-control input-sm", style: "width: 60px; display: inline-block" %>
              <%= player.name %>
              <%= link_to "削除",
                    tournament_player_path(@tournament, player),
                    data: { "turbo-method": :delete, "turbo-confirm": "削除しますか？" },
                    class: "btn btn-xs btn-danger pull-right" %>
            </li>
          <% end %>
        </ul>
        <%= f.submit "確定してトーナメントツリーを作成する。", class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <ul class="list-group">
        <% players.each do |player| %>
          <li class="list-group-item">
            <%= player.position ? "[#{player.position}] " : "" %><%= player.name %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if current_user?(@tournament.user) %>
    <div class="col-md-4">
      <div class="well">
        <h4>選手登録</h4>
        <%= form_with(model: [@tournament, Player.new]) do |f| %>
          <div class="field">
            <%= f.text_field :name, placeholder: "プレイヤー名", class: "form-control" %>
          </div>
          <%= f.submit "追加", class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
