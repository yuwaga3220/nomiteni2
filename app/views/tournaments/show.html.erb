<% provide(:title, @tournament.title) %>
<div class="tournament">
  <h1><%= @tournament.title %></h1>
  <% if @tournament.held_on.present? %>
    <p>開催日: <%= @tournament.held_on.strftime("%Y年%m月%d日") %></p>
  <% end %>
  <% if @tournament.venue.present? %>
    <p>場所: <%= @tournament.venue %></p>
  <% end %>
  <% if @tournament.description.present? %>
    <p><%= @tournament.description %></p>
  <% end %>
  <% if current_user?(@tournament.user) %>
    <%= form_with url: update_status_tournament_path(@tournament), method: :patch do |f| %>
      <%= f.radio_button :status, "before", id: "status_before", checked: @tournament.before?, onchange: "if(confirm('本当にトーナメントステータスを更新しますか？')) { this.form.requestSubmit(); } else { this.form.reset(); }" %>
      <%= label_tag "status_before", "開催前" %>
      <%= f.radio_button :status, "during", id: "status_during", checked: @tournament.during?, onchange: "if(confirm('本当にトーナメントステータスを更新しますか？')) { this.form.requestSubmit(); } else { this.form.reset(); }" %>
      <%= label_tag "status_during", "開催中" %>
      <%= f.radio_button :status, "after", id: "status_after", checked: @tournament.after?, onchange: "if(confirm('本当にトーナメントステータスを更新しますか？')) { this.form.requestSubmit(); } else { this.form.reset(); }" %>
      <%= label_tag "status_after", "開催後" %>
    <% end %>
  <% else %>
    <% status_labels = { "before" => "開催前", "during" => "開催中", "after" => "開催後" } %>
    <p>ステータス: <strong><%= status_labels[@tournament.status] %></strong></p>
  <% end %>
</div>

<% unless @tournament.matches.any? %>
  <div class="row">
    <%= render "participant_list" %>
    <%= render "participant_form" if current_user?(@tournament.user) %>
  </div>
<% end %>

<%= render "bracket", editable: current_user?(@tournament.user) && !@tournament.before? if @tournament.matches.any? %>
