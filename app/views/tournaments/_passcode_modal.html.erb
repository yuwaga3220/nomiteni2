<span data-controller="passcode-modal">
  <%= link_to label, "#", class: "btn btn-lavender btn-sm", data: { action: "click->passcode-modal#open" } %>
  <div data-passcode-modal-target="backdrop" class="modal-backdrop" style="display: none;" data-action="click->passcode-modal#close"></div>
  <div data-passcode-modal-target="modal" class="modal" style="display: none;" data-action="click->passcode-modal#closeIfOutside">
    <div class="modal-dialog modal-sm">
      <div class="modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-action="click->passcode-modal#close">&times;</button>
          <h4 class="modal-title">パスコードを入力</h4>
        </div>
        <%= form_with url: tournament_passcode_path(tournament), method: :post do |f| %>
          <div class="modal-body">
            <div class="field">
              <%= f.label :passcode, "この大会の4桁のパスコード" %>
              <%= f.text_field :passcode, maxlength: 4, inputmode: "numeric", pattern: "\\d{4}",
                    class: "form-control", autocomplete: "off" %>
            </div>
            <%= hidden_field_tag :next, next_target %>
          </div>
          <div class="modal-footer" style="border-top: 0;">
            <%= f.submit "入室する", class: "btn btn-primary btn-block" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</span>
