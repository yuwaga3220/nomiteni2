<div class="row">
  <div class="col-md-12">
    <h3 class="bracket-heading">
      ドロー
      <% if current_user?(@tournament.user) %>
        <%= link_to "削除", destroy_all_tournament_matches_path(@tournament),
              data: { "turbo-method": :delete, "turbo-confirm": "トーナメントツリーを削除しますか？" },
              class: "btn btn-xs btn-danger pull-right" %>
      <% end %>
    </h3>
    <% grouped = @tournament.matches.includes(:participant1, :participant2, :winner)
                                     .group_by(&:round).sort
       bracket_data = {
         rounds: grouped.map { |round, _| { name: "Round #{round}" } },
         matches: grouped.flat_map { |round, matches|
           matches.each_with_index.map { |_match, i| { roundIndex: round - 1, order: i } }
         }
       } %>
    <div class="bracket-match-templates" style="display: none;">
      <% grouped.each do |round, matches| %>
        <% matches.each_with_index do |match, i| %>
          <div id="bracket-match-<%= round - 1 %>-<%= i %>">
            <div style="width: 190px; position: relative;">
              <% status_labels = { "pending" => "準備中", "in_progress" => "試合中", "finished" => "終了" }
                 show_meta = match.court.present? || !match.pending?
                 match_meta = [ status_labels[match.status], (match.court.presence unless match.finished?) ].compact.join(" ・ ")
                 p1 = match.participant1
                 p2 = match.participant2
                 p1_class = p1.present? && match.winner == p1 ? "bracket-slot-winner" : "bracket-slot"
                 p2_class = p2.present? && match.winner == p2 ? "bracket-slot-winner" : "bracket-slot"
                 p1_games = match.winner == p1 ? match.winner_games : (match.winner == p2 ? match.loser_games : nil)
                 p2_games = match.winner == p2 ? match.winner_games : (match.winner == p1 ? match.loser_games : nil) %>
              <% if editable && p1.present? && p2.present? %>
                <div class="btn btn-sm" style="width: 100%; padding: 0; border: 0; cursor: pointer;"
                     data-controller="bracket-match-trigger"
                     data-bracket-match-trigger-modal-id-value="match-result-modal-<%= match.id %>"
                     data-action="click->bracket-match-trigger#open">
                  <div class="<%= p1_class %>" style="box-sizing: border-box; height: 42px; border-radius: 4px 4px 0 0; padding: 10px 12px; font-size: 1em; overflow: hidden;">
                    <%= p1.name %>
                    <% if p1_games.present? %><span class="pull-right bracket-slot-score"><%= p1_games %></span><% end %>
                  </div>
                  <div class="<%= p2_class %>" style="box-sizing: border-box; height: 42px; border-radius: 0 0 4px 4px; padding: 10px 12px; font-size: 1em; overflow: hidden;">
                    <%= p2.name %>
                    <% if p2_games.present? %><span class="pull-right bracket-slot-score"><%= p2_games %></span><% end %>
                  </div>
                </div>
              <% else %>
                <div class="<%= p1_class %> <%= 'bracket-slot-empty' unless p1.present? %>" style="box-sizing: border-box; height: 42px; width: 100%; border-radius: 4px 4px 0 0; margin: 0; padding: 10px 12px; font-size: 1em; cursor: default; overflow: hidden;">
                  <%= p1&.name || "未定" %>
                  <% if p1_games.present? %><span class="pull-right bracket-slot-score"><%= p1_games %></span><% end %>
                </div>
                <div class="<%= p2_class %> <%= 'bracket-slot-empty' unless p2.present? %>" style="box-sizing: border-box; height: 42px; width: 100%; border-radius: 0 0 4px 4px; padding: 10px 12px; font-size: 1em; cursor: default; overflow: hidden;">
                  <%= p2&.name || "未定" %>
                  <% if p2_games.present? %><span class="pull-right bracket-slot-score"><%= p2_games %></span><% end %>
                </div>
              <% end %>
              <% if show_meta %>
                <div style="position: absolute; top: 100%; left: 0; font-size: 0.7em; color: <%= match.finished? ? '#666' : '#623fbc' %>; white-space: nowrap;">
                  <%= match_meta %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
    <div class="bracket-wrapper" data-controller="bracket" data-bracket-data-value="<%= bracket_data.to_json %>"></div>
    <% if editable %>
      <% grouped.each do |_round, matches| %>
        <% matches.each do |match| %>
          <% p1 = match.participant1
             p2 = match.participant2 %>
          <% if p1.present? && p2.present? %>
            <%= render "match_result_modal", match: match, p1: p1, p2: p2 %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</div>
