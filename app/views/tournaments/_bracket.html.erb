<div class="row">
  <div class="col-md-12">
    <h3>
      トーナメントツリー
      <% if current_user?(@tournament.user) %>
        <%= link_to "削除", destroy_all_tournament_matches_path(@tournament),
              data: { "turbo-method": :delete, "turbo-confirm": "トーナメントツリーを削除しますか？" },
              class: "btn btn-xs btn-danger" %>
      <% end %>
    </h3>
    <div class="bracket" style="display: flex; gap: 24px; align-items: flex-start;">
      <% @tournament.matches.includes(:participant1, :participant2, :winner)
                            .group_by(&:round).sort.each do |round, matches| %>
        <div class="bracket-round" style="min-width: 200px;">
          <h4><%= round %>回戦</h4>
          <% matches.each do |match| %>
            <div style="margin-bottom: 16px;">
              <div style="width: 160px;">
                <%= button_to match.participant1&.name || "未定",
                      set_winner_tournament_match_path(@tournament, match),
                      params: { slot: 1 },
                      method: :patch,
                      form: { style: "display: block; margin: 0;" },
                      class: "btn btn-xs #{match.winner == match.participant1 ? 'btn-success' : 'btn-default'}",
                      style: "width: 100%; border-radius: 4px 4px 0 0; margin: 0;" %>
                <%= button_to match.participant2&.name || "未定",
                      set_winner_tournament_match_path(@tournament, match),
                      params: { slot: 2 },
                      method: :patch,
                      form: { style: "display: block; margin: 0;" },
                      class: "btn btn-xs #{match.winner == match.participant2 ? 'btn-success' : 'btn-default'}",
                      style: "width: 100%; border-radius: 0 0 4px 4px; margin-top: -1px;" %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
