<% grouped = @all_matches.group_by(&:round).sort
   bracket_data = {
     rounds: grouped.map { |round, _| { name: "Round #{round}" } },
     matches: grouped.flat_map { |round, matches|
       matches.each_with_index.map { |_match, i| { roundIndex: round - 1, order: i } }
     }
   } %>
<div class="bracket-match-templates" style="display: none;">
  <% grouped.each do |round, matches| %>
    <% matches.each_with_index do |match, i| %>
      <% if round == 1
           p1 = match.participant1
           p2 = match.participant2
         else
            # 前のラウンドの試合を取得
           feeder1 = @feeder_matches[[match.id, 1]]
           feeder2 = @feeder_matches[[match.id, 2]]
           # 前のラウンドの試合の予想勝者を取得
           p1 = @existing_predictions[feeder1&.id]&.predicted_participant
           p2 = @existing_predictions[feeder2&.id]&.predicted_participant
         end
         # その試合の予想を取得
         prediction  = @existing_predictions[match.id]
         # 予想が選択されているかどうかを判定
         p1_selected = p1.present? && prediction&.predicted_participant_id == p1.id
         p2_selected = p2.present? && prediction&.predicted_participant_id == p2.id %>
      <% p1_class = "bracket-slot #{'bracket-slot-selected' if p1_selected} #{'bracket-slot-empty' unless p1.present?}"
         p2_class = "bracket-slot #{'bracket-slot-selected' if p2_selected} #{'bracket-slot-empty' unless p2.present?}" %>
      <div id="bracket-match-<%= round - 1 %>-<%= i %>">
        <div style="width: 190px; position: relative;">
          <div class="bracket-match-label">
            R<%= round %>-<%= i + 1 %><% if match.court.present? && !match.finished? %> (コート：<%= match.court %>)<% end %>
          </div>
          <%= button_to p1&.name || "未定",
                tournament_prediction_path(@tournament),
                params: { match_id: match.id, participant_id: p1&.id },
                method: :post,
                form: { style: "display: block; margin: 0;" },
                disabled: p1.nil? || !@tournament.before?,
                class: p1_class,
                style: "box-sizing: border-box; height: 42px; width: 100%; border-radius: 4px 4px 0 0; margin: 0; padding: 10px 12px; font-size: 1em; overflow: hidden; cursor: #{p1.nil? || !@tournament.before? ? 'default' : 'pointer'};" %>
          <%= button_to p2&.name || "未定",
                tournament_prediction_path(@tournament),
                params: { match_id: match.id, participant_id: p2&.id },
                method: :post,
                form: { style: "display: block; margin: 0;" },
                disabled: p2.nil? || !@tournament.before?,
                class: p2_class,
                style: "box-sizing: border-box; height: 42px; width: 100%; border-radius: 0 0 4px 4px; margin-top: -1px; padding: 10px 12px; font-size: 1em; overflow: hidden; cursor: #{p2.nil? || !@tournament.before? ? 'default' : 'pointer'};" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
<div class="bracket-wrapper" data-controller="bracket" data-bracket-data-value="<%= bracket_data.to_json %>"></div>
