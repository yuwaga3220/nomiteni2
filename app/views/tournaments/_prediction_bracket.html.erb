<% grouped = @all_matches.group_by(&:round).sort
   bracket_data = {
     rounds: grouped.map { |round, _| { name: "Round #{round}" } },
     matches: grouped.flat_map { |round, matches|
       matches.each_with_index.map { |_match, i| { roundIndex: round - 1, order: i } }
     }
   } %>
<div class="bracket-match-templates" style="display: none;">
  <% grouped.each do |round, matches| %>
    <% matches.each_with_index do |match, i| %>
      <% if round == 1
           p1 = match.participant1
           p2 = match.participant2
         else
            # 前のラウンドの試合を取得
           feeder1 = @feeder_matches[[match.id, 1]]
           feeder2 = @feeder_matches[[match.id, 2]]
           # 前のラウンドの試合の予想勝者を取得（不戦勝の試合は予想できないため、確定した勝者を使う）
           p1 = feeder1&.walkover? ? feeder1.winner : @existing_predictions[feeder1&.id]&.predicted_participant
           p2 = feeder2&.walkover? ? feeder2.winner : @existing_predictions[feeder2&.id]&.predicted_participant
         end
         # その試合の予想を取得
         prediction  = @existing_predictions[match.id]
         # 予想が選択されているかどうかを判定
         p1_selected = p1.present? && prediction&.predicted_participant_id == p1.id
         p2_selected = p2.present? && prediction&.predicted_participant_id == p2.id
         # 棄権者を含む試合は予想できない
         p1_disabled = p1.nil? || !@tournament.before? || match.walkover? || p1.withdrawn? || p2&.withdrawn?
         p2_disabled = p2.nil? || !@tournament.before? || match.walkover? || p2.withdrawn? || p1&.withdrawn?
         p1_label = p1 ? "#{p1.name}#{'（棄権）' if p1.withdrawn?}" : "未定"
         p2_label = p2 ? "#{p2.name}#{'（棄権）' if p2.withdrawn?}" : "未定" %>
      <% p1_class = "bracket-slot #{'bracket-slot-selected' if p1_selected} #{'bracket-slot-empty' unless p1.present?} #{'bracket-slot-muted' if p1&.withdrawn?}"
         p2_class = "bracket-slot #{'bracket-slot-selected' if p2_selected} #{'bracket-slot-empty' unless p2.present?} #{'bracket-slot-muted' if p2&.withdrawn?}" %>
      <div id="bracket-match-<%= round - 1 %>-<%= i %>">
        <div style="width: 190px; position: relative;">
          <div class="bracket-match-label">
            R<%= round %>-<%= i + 1 %><% if match.court.present? && !match.finished? %> (コート：<%= match.court %>)<% end %>
          </div>
          <% if match.finished? && prediction.present? %>
            <% prediction_correct = prediction.predicted_participant_id == match.winner_id %>
            <span class="glyphicon <%= prediction_correct ? 'glyphicon-ok' : 'glyphicon-remove' %> prediction-result-icon <%= prediction_correct ? 'prediction-result-correct' : 'prediction-result-incorrect' %>" aria-hidden="true"></span>
          <% end %>
          <%= button_to p1_label,
                tournament_prediction_path(@tournament),
                params: { match_id: match.id, participant_id: p1&.id },
                method: :post,
                form: { style: "display: block; margin: 0;" },
                disabled: p1_disabled,
                class: p1_class,
                style: "box-sizing: border-box; height: 42px; width: 100%; border-radius: 4px 4px 0 0; margin: 0; padding: 10px 12px; font-size: 1em; overflow: hidden; cursor: #{p1_disabled ? 'default' : 'pointer'};" %>
          <%= button_to p2_label,
                tournament_prediction_path(@tournament),
                params: { match_id: match.id, participant_id: p2&.id },
                method: :post,
                form: { style: "display: block; margin: 0;" },
                disabled: p2_disabled,
                class: p2_class,
                style: "box-sizing: border-box; height: 42px; width: 100%; border-radius: 0 0 4px 4px; margin-top: -1px; padding: 10px 12px; font-size: 1em; overflow: hidden; cursor: #{p2_disabled ? 'default' : 'pointer'};" %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
<div class="bracket-wrapper" data-controller="bracket" data-bracket-data-value="<%= bracket_data.to_json %>" data-bracket-preserve-scroll-value="<%= local_assigns.fetch(:preserve_scroll, false) %>"></div>
