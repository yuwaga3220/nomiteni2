<li id="tournament-<%= tournament.id %>">
  <span class="content">
    <h3><%= tournament.title %></h3>
  </span>
  <% if tournament.held_on.present? %>
    <span class="held-on"><%= tournament.held_on.strftime("%Y/%m/%d") %></span>
  <% end %>
  <br>
  <% if current_user?(tournament.user) %>
    <%= link_to "管理画面", tournament%>
  <% else %>
    <%= link_to "トーナメント", tournament%>
  <% end %>
  or
  <%= link_to "ピッケム", new_tournament_prediction_path(tournament) %>
  <br>
  <span class="timestamp pull-right">
    <% if current_user?(tournament.user) %>
      <%= link_to "削除", tournament, data: { "turbo-method": :delete,
                                             "turbo-confirm": "本当に削除しますか？" } %>
    <% end %>
  </span>
</li>
