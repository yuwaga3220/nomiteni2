<div class="col-sm-6 col-md-4">
  <div class="panel panel-default tournament-card <%= 'tournament-card-with-image' if tournament.image.attached? %>"
       id="tournament-<%= tournament.id %>"
       <% if tournament.image.attached? %>style="background-image: url(<%= url_for(tournament.image.variant(:mosaic)) %>);"<% end %>>
    <div class="panel-body">
      <% if tournament.held_on.present? %>
        <%= link_to google_calendar_url(tournament), target: "_blank", rel: "noopener",
              class: "tournament-card-calendar-link", title: "Googleカレンダーに登録" do %>
          <span class="glyphicon glyphicon-calendar" aria-hidden="true"></span>
        <% end %>
      <% end %>
      <h4 class="tournament-card-title"><%= tournament.title %></h4>
      <% if tournament.held_on.present? || tournament.venue.present? %>
        <p class="held-on" style="text-align: center;">
          <%= tournament.held_on&.strftime("%y/%m/%d") %><% if tournament.venue.present? %>（<%= tournament.venue %>）<% end %>
        </p>
      <% end %>
      <p class="text-center">
        <% if current_user?(tournament.user) %>
          <%= link_to "管理画面", tournament, class: "btn btn-lavender btn-sm" %>
        <% else %>
          <%= link_to "試合状況", tournament, class: "btn btn-lavender btn-sm" %>
        <% end %>
        <%= link_to "PICK'EMS（予想）", new_tournament_prediction_path(tournament), class: "btn btn-lavender btn-sm" %>
      </p>
      <% if current_user?(tournament.user) %>
        <p class="timestamp text-center">
          <%= link_to "削除", tournament, data: { "turbo-method": :delete,
                                                 "turbo-confirm": "本当に削除しますか？" } %>
        </p>
      <% end %>
    </div>
  </div>
</div>
