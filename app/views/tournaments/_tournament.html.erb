<li id="tournament-<%= tournament.id %>">
  <span class="content">
    <strong><%= link_to tournament.title, tournament %></strong>
    <% if tournament.held_on.present? %>
      <span class="held-on"> 開催日: <%= tournament.held_on.strftime("%Y年%m月%d日") %></span>
    <% end %>
    <% if tournament.venue.present? %>
      <span class="venue"> 場所: <%= tournament.venue %></span>
    <% end %>
    <% if tournament.description.present? %>
      <p><%= tournament.description %></p>
    <% end %>
  </span>
  <span class="user"><%= link_to tournament.user.name, tournament.user %></span>
  <span class="timestamp">
    <%= time_ago_in_words(tournament.created_at) %>前に作成
    <% if current_user?(tournament.user) %>
      <%= link_to "削除", tournament, data: { "turbo-method": :delete,
                                             "turbo-confirm": "本当に削除しますか？" } %>
    <% end %>
  </span>
</li>
