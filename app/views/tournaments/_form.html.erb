<%= form_with(model: tournament) do |f| %>
  <%= render 'shared/error_messages', object: f.object %>
  <div class="field">
    <%= f.label :title, "大会名" %>
    <%= f.text_field :title, placeholder: "大会名を入力..." %>
  </div>
  <div class="field">
    <%= f.label :description, "詳細（任意）" %>
    <%= f.text_area :description, placeholder: "大会の詳細（任意）", rows: 3 %>
  </div>
  <div class="field">
    <%= f.label :held_on, "開催日" %>
    <%= f.date_field :held_on %>
  </div>
  <div class="field">
    <%= f.label :venue, "開催場所（任意）" %>
    <%= f.text_field :venue, placeholder: "開催場所（任意）" %>
  </div>
  <div class="field">
    <%= f.label :image, "イメージ画像（任意）" %>
    <%= f.file_field :image, accept: "image/png,image/jpeg,image/gif,image/webp" %>
  </div>
  <%= f.submit "大会を公開する", class: "btn btn-primary btn-block" %>
<% end %>
