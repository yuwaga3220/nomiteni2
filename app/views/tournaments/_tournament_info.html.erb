<div class="tournament">
  <% if tournament.held_on.present? || tournament.venue.present? %>
    <div class="tournament-meta">
      <% if tournament.held_on.present? %>
        <div class="tournament-meta-item">
          <div class="tournament-meta-label">開催日</div>
          <div class="tournament-meta-value"><%= tournament.held_on.strftime("%y/%m/%d") %></div>
        </div>
      <% end %>
      <% if tournament.venue.present? %>
        <div class="tournament-meta-item">
          <div class="tournament-meta-label">場所</div>
          <div class="tournament-meta-value"><%= tournament.venue %></div>
        </div>
      <% end %>
    </div>
  <% end %>
  <% if tournament.description.present? %>
    <p class="tournament-description"><%= tournament.description %></p>
  <% end %>
  <% if owner_view %>
    <%= render "tournaments/status_form", tournament: tournament %>
  <% else %>
    <% status_labels = { "before" => "開催前", "during" => "開催中", "after" => "開催後" } %>
    <p class="status-toggle-heading">ステータス</p>
    <p class="tournament-status-value"><%= status_labels[tournament.status] %></p>
  <% end %>
</div>
