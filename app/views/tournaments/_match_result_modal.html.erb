<div data-controller="match-result-modal">
  <div data-match-result-modal-target="backdrop" class="modal-backdrop" style="display: none;" data-action="click->match-result-modal#close"></div>
  <div data-match-result-modal-target="modal" class="modal" style="display: none;" id="match-result-modal-<%= match.id %>" data-action="click->match-result-modal#closeIfOutside">
    <div class="modal-dialog modal-sm">
      <div class="modal-content match-result-modal-content">
        <div class="modal-header">
          <button type="button" class="close" data-action="click->match-result-modal#close">&times;</button>
          <h4 class="modal-title"><%= p1.name %> vs <%= p2.name %></h4>
        </div>
        <%= form_with url: update_status_tournament_match_path(tournament, match), method: :patch do %>
          <div class="modal-body">
            <div class="match-result-row">
              <div class="form-group">
                <label>コート名</label>
                <%= text_field_tag "court", match.court, class: "form-control" %>
              </div>
              <div class="form-group">
                <label>試合状況</label>
                <%= select_tag "status",
                      options_for_select(
                        [ [ "予備", "pending" ], [ "試合中", "in_progress" ], [ "終了", "finished" ] ],
                        match.status),
                      class: "form-control" %>
              </div>
            </div>
          </div>
          <div class="modal-body match-result-score-body">
            <div class="match-result-row">
              <div class="form-group">
                <label><%= p1.name %></label>
                <%= render "tournaments/game_stepper", field: "participant1_games", name_label: p1.name,
                      games: match.games_for(1) %>
              </div>
              <div class="form-group">
                <label><%= p2.name %></label>
                <%= render "tournaments/game_stepper", field: "participant2_games", name_label: p2.name,
                      games: match.games_for(2) %>
              </div>
            </div>
            <p class="match-result-hint">試合状況を「終了」にして保存すると、勝敗が確定します。</p>
          </div>
          <div class="modal-footer match-result-modal-footer">
            <%= submit_tag "保存", class: "btn btn-primary btn-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
