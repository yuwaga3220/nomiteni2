<div data-match-result-modal-target="backdrop" class="modal-backdrop" style="display: none;" data-action="click->match-result-modal#close"></div>
<div data-match-result-modal-target="modal" class="modal" style="display: none;" id="match-result-modal-<%= match.id %>">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-action="click->match-result-modal#close">&times;</button>
        <h4 class="modal-title"><%= p1.name %> vs <%= p2.name %></h4>
      </div>
      <%= form_with url: set_winner_tournament_match_path(@tournament, match), method: :patch do %>
        <div class="modal-body">
          <div class="form-group">
            <label><%= p1.name %>の獲得ゲーム数</label>
            <%= number_field_tag "participant1_games", match.winner == p1 ? match.winner_games : (match.winner == p2 ? match.loser_games : nil), min: 0, required: true, class: "form-control", data: { "match-result-modal-target": "firstInput" } %>
          </div>
          <div class="form-group">
            <label><%= p2.name %>の獲得ゲーム数</label>
            <%= number_field_tag "participant2_games", match.winner == p2 ? match.winner_games : (match.winner == p1 ? match.loser_games : nil), min: 0, required: true, class: "form-control" %>
          </div>
        </div>
        <div class="modal-footer">
          <%= submit_tag "結果を確定", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
