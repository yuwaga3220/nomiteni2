<% provide(:title, "ログイン") %>
<h2>ログイン</h2>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= form_with(url: login_path, scope: :session) do |f| %>

      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, class: 'form-control' %>

      <%= f.label :password, "パスワード" %>
      <%= link_to "(パスワードをお忘れの方)", new_password_reset_path, class: "login-hint-link" %>
      <%= f.password_field :password, class: 'form-control' %>

      <%= f.label :remember_me, class: "checkbox inline" do %>
        <%= f.check_box :remember_me %>
        <span>ログインしたままにする</span>
      <% end %>

      <%= f.submit "ログイン", class: "btn btn-primary" %>
    <% end %>

    <div class="text-center">
      <p>または</p>
      <%= button_to "Googleでログイン", "/auth/google_oauth2",
            method: :post,
            data: { turbo: false },
            class: "btn btn-default btn-block" %>
    </div>

    <p class="text-center login-hint">初めてご利用の方は <%= link_to "こちら", signup_path, class: "login-hint-link" %></p>
  </div>
</div>
